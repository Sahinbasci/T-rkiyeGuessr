# Site URL (canonical, sitemap, robots, OG) — change when domain swap
NEXT_PUBLIC_SITE_URL=https://turkiyeguessr.com

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# AdSense Configuration
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_AD_SLOT_BANNER=0000000000
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=0000000001
NEXT_PUBLIC_AD_SLOT_INTERSTITIAL=0000000002
NEXT_PUBLIC_ENABLE_INTERSTITIAL_ADS=false

# GA4 Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Premium (ads-free) Feature Flag
NEXT_PUBLIC_ENABLE_PREMIUM=false
