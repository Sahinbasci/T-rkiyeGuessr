{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.turkiyeguessr.com" }],
      "destination": "https://turkiyeguessr.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "turkiyeguessr.xyz" }],
      "destination": "https://turkiyeguessr.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.turkiyeguessr.xyz" }],
      "destination": "https://turkiyeguessr.com/$1",
      "statusCode": 301
    },
    {
      "source": "/bolgeler/ic_anadolu",
      "destination": "/bolgeler/ic-anadolu",
      "statusCode": 301
    },
    {
      "source": "/bolgeler/dogu_anadolu",
      "destination": "/bolgeler/dogu-anadolu",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-index"
    }
  ]
}
